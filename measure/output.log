from PIL import Image
import os
import sys

def jpg_to_png(jpg_path, png_path, target_size=None):
    """Convert JPG to PNG, optionally resize."""
    img = Image.open(jpg_path).convert("RGBA")
    if target_size:
        img = img.resize(target_size, Image.Resampling.LANCZOS)
    img.save(png_path)
    return img

def create_uniform_sheet(source_img, output_path, frames_per_row=3):
    """Create a 3x3 sheet with the same image in all frames."""
    frame_w, frame_h = source_img.size
    sheet_w = frame_w * frames_per_row
    sheet_h = frame_h * frames_per_row
    sheet = Image.new("RGBA", (sheet_w, sheet_h), (0, 0, 0, 0))
    
    for i in range(9):
        row = i // frames_per_row
        col = i % frames_per_row
        sheet.paste(source_img, (col * frame_w, row * frame_h), source_img)
    
    sheet.save(output_path)
    print(f"Created: {output_path} ({sheet_w}x{sheet_h})")

if __name__ == "__main__":
    out_dir = "/home/daniel-bo/Desktop/advantage-games/public/games/sentence/labyrinth-goblin-king"
    
    # Paladin sheet (288x288 total = 96x96 per frame)
    paladin = jpg_to_png("/tmp/labyrinth-assets/paladin-idle_001.jpg", "/tmp/paladin.png", (96, 96))
    create_uniform_sheet(paladin, f"{out_dir}/paladin_3x3_pose_sheet.png")
    
    # Goblin scout sheet
    goblin = jpg_to_png("/tmp/labyrinth-assets/goblin-scout_001.jpg", "/tmp/goblin.png", (96, 96))
    create_uniform_sheet(goblin, f"{out_dir}/goblin_scout_3x3_pose_sheet.png")
    
    print("Done!")
