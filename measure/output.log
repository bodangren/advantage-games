from PIL import Image
import os

out_dir = "/home/daniel-bo/Desktop/advantage-games/public/games/sentence/gryphon-patrol"

def jpg_to_png(jpg_path, png_path, target_size=None):
    img = Image.open(jpg_path).convert("RGBA")
    if target_size:
        img = img.resize(target_size, Image.Resampling.LANCZOS)
    img.save(png_path)
    return img

def create_uniform_sheet(source_img, output_path, frames_per_row=3):
    frame_w, frame_h = source_img.size
    sheet_w = frame_w * frames_per_row
    sheet_h = frame_h * frames_per_row
    sheet = Image.new("RGBA", (sheet_w, sheet_h), (0, 0, 0, 0))
    
    for i in range(9):
        row = i // frames_per_row
        col = i % frames_per_row
        sheet.paste(source_img, (col * frame_w, row * frame_h), source_img)
    
    sheet.save(output_path)
    print(f"Created sheet: {output_path}")

# Convert static assets
jpg_to_png(f"{out_dir}/parallax-sky-top_001.jpg", f"{out_dir}/parallax-sky-top.png")
jpg_to_png(f"{out_dir}/parallax-clouds-middle_001.jpg", f"{out_dir}/parallax-clouds-middle.png")
jpg_to_png(f"{out_dir}/parallax-landscape-bottom_001.jpg", f"{out_dir}/parallax-landscape-bottom.png")
jpg_to_png(f"{out_dir}/word-orb_001.jpg", f"{out_dir}/word-orb.png")
jpg_to_png(f"{out_dir}/feather-bolt_001.jpg", f"{out_dir}/feather-bolt.png")

# Create sprite sheets (128x128 per frame = 384x384 sheet)
player = jpg_to_png("/tmp/gryphon-assets/player_001.jpg", "/tmp/gryphon-player.png", (128, 128))
create_uniform_sheet(player, f"{out_dir}/player_gryphon_rider_3x3_pose_sheet.png")

enemy = jpg_to_png("/tmp/gryphon-assets/enemy_001.jpg", "/tmp/gryphon-enemy.png", (128, 128))
create_uniform_sheet(enemy, f"{out_dir}/sky_raider_3x3_pose_sheet.png")

# Clean up JPGs
for f in os.listdir(out_dir):
    if f.endswith('.jpg'):
        os.remove(os.path.join(out_dir, f))

print("Gryphon Patrol assets ready!")
