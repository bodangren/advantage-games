from PIL import Image
import os
import shutil

out_dir = "/home/daniel-bo/Desktop/advantage-games/public/games/sentence/haunted-library"

def jpg_to_png(jpg_path, png_path, target_size=None):
    img = Image.open(jpg_path).convert("RGBA")
    if target_size:
        img = img.resize(target_size, Image.Resampling.LANCZOS)
    img.save(png_path)
    return img

def create_uniform_sheet(source_img, output_path, frames_per_row=3):
    frame_w, frame_h = source_img.size
    sheet_w = frame_w * frames_per_row
    sheet_h = frame_h * frames_per_row
    sheet = Image.new("RGBA", (sheet_w, sheet_h), (0, 0, 0, 0))
    
    for i in range(9):
        row = i // frames_per_row
        col = i % frames_per_row
        sheet.paste(source_img, (col * frame_w, row * frame_h), source_img)
    
    sheet.save(output_path)
    print(f"Created sheet: {output_path}")

# Convert static assets
jpg_to_png(f"{out_dir}/library-background_001.jpg", f"{out_dir}/library-background.png")
jpg_to_png(f"{out_dir}/floor-strip_001.jpg", f"{out_dir}/floor-strip.png")
jpg_to_png(f"{out_dir}/trampoline_001.jpg", f"{out_dir}/trampoline.png")
jpg_to_png(f"{out_dir}/door-closed_001.jpg", f"{out_dir}/door-closed.png")
jpg_to_png(f"{out_dir}/door-open-correct_001.jpg", f"{out_dir}/door-open-correct.png")
jpg_to_png(f"{out_dir}/door-open-trap_001.jpg", f"{out_dir}/door-open-trap.png")

# Create sprite sheets (128x128 per frame = 384x384 sheet)
player = jpg_to_png("/tmp/haunted-assets/player_001.jpg", "/tmp/player.png", (128, 128))
create_uniform_sheet(player, f"{out_dir}/player_3x3_pose_sheet.png")

ghost = jpg_to_png("/tmp/haunted-assets/ghost_001.jpg", "/tmp/ghost.png", (128, 128))
create_uniform_sheet(ghost, f"{out_dir}/ghost_3x3_pose_sheet.png")

bat = jpg_to_png("/tmp/haunted-assets/bat_001.jpg", "/tmp/bat.png", (128, 128))
create_uniform_sheet(bat, f"{out_dir}/bat_3x3_pose_sheet.png")

# Clean up JPGs
for f in os.listdir(out_dir):
    if f.endswith('.jpg'):
        os.remove(os.path.join(out_dir, f))

print("Haunted Library assets ready!")
