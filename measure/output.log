from PIL import Image
import sys
import os

def create_sprite_sheet(input_paths, output_path, frames_per_row=3):
    """
    Create a 3x3 sprite sheet from input images.
    If fewer than 9 images provided, cycles through them.
    """
    images = []
    for path in input_paths:
        if os.path.exists(path):
            img = Image.open(path).convert("RGBA")
            images.append(img)
    
    if not images:
        raise ValueError("No valid input images")
    
    # Determine frame size from first image
    frame_w, frame_h = images[0].size
    
    # Create sheet
    sheet_w = frame_w * frames_per_row
    sheet_h = frame_h * frames_per_row
    sheet = Image.new("RGBA", (sheet_w, sheet_h), (0, 0, 0, 0))
    
    # Place images
    for i in range(9):
        row = i // frames_per_row
        col = i % frames_per_row
        img = images[i % len(images)]
        # Resize to match first image if needed
        if img.size != (frame_w, frame_h):
            img = img.resize((frame_w, frame_h), Image.Resampling.LANCZOS)
        sheet.paste(img, (col * frame_w, row * frame_h), img)
    
    sheet.save(output_path)
    print(f"Created sprite sheet: {output_path} ({sheet_w}x{sheet_h})")

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: python create_sprite_sheet.py output.png input1.png [input2.png ...]")
        sys.exit(1)
    
    output_path = sys.argv[1]
    input_paths = sys.argv[2:]
    create_sprite_sheet(input_paths, output_path)
