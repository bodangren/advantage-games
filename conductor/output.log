import { useGameLoop } from './useGameLoop'

function GameLoopHarness({ running, tickMs, onTick }: { running: boolean; tickMs?: number; onTick: (dt: number) => void }) {
  useGameLoop(onTick, running, tickMs)
  return null
}

describe('useGameLoop', () => {
  beforeEach(() => {
    jest.useFakeTimers()
  })

  afterEach(() => {
    jest.clearAllTimers()
    jest.useRealTimers()
  })

