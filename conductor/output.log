+    
+    expect(client.metadata.isAlive).toBe(true);
+    
+    // Simulate pong response
+    client.emit('pong');
+    
+    expect(client.metadata.isAlive).toBe(true);
+  });
+
+  it('should terminate client on heartbeat when isAlive is false', async () => {
+    const client = new WebSocket('ws://localhost:1234');
+    wss.simulateConnection(client);
+    
+    // Set metadata to not alive
+    client.metadata.isAlive = false;
+    
+    // Trigger ping which should check isAlive and terminate
+    client.ping();
+    
+    // Wait for the setTimeout in ping to execute
+    await new Promise(resolve => setTimeout(resolve, 200));
+    
+    expect(client.readyState).toBe(WebSocket.CLOSED);
+    expect(wss.clients.has(client)).toBe(false);
+  }, 5000);
+
